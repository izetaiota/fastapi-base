# Copy to .env.dev / .env.test / .env.prod and adjust values
ENV=dev

PROJECT_NAME=fastapi-base

# Database
# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/fastapi_base
# MySQL (asyncmy)
# DATABASE_URL=mysql+asyncmy://user:pass@127.0.0.1:3306/fastapi_base?charset=utf8mb4

# DB pool settings
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

# JWT
JWT_SECRET=change_me
JWT_ALG=HS256

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# CORS (comma-separated)
CORS_ORIGINS=*

# Rate limit
RATE_LIMIT=100/minute

# Cache
CACHE_PREFIX=fastapi-cache
